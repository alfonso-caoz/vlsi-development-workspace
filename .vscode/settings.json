{
    // Spellcheck Whitelist
    "cSpell.words": [
        "amba",
        "asic",
        "aspec",
        "bierner",
        "dpkg",
        "fips",
        "fspec",
        "gdsii",
        "gperf",
        "gtkwave",
        "iverilog",
        "keyrings",
        "libcanberra-gtk3-module",
        "libfl-dev",
        "libreadline-dev",
        "librelane",
        "libz3-dev",
        "microarchitecture",
        "mshr",
        "multiplatform",
        "needtable",
        "noninteractive",
        "setuptools",
        "sphinxcontrib",
        "synthesizable",
        "testbench",
        "toctree",
        "ubproject",
        "utest",
        "venv",
        "verilator",
        "verilog",
        "vlsi",
        "xhost",
        "yahyabatulu"
    ],

    // Spellcheck These File Types
    "cSpell.enabledFileTypes": {
        "assembly": true,
        "c": true,
        "cmake": true,
        "cpp": true,
        "dockerfile": true,
        "ignore": true,
        "json": true,
        "jsonc": true,
        "makefile": true,
        "markdown": true,
        "perl": true,
        "python": true,
        "restructuredtext": true,
        "shellscript": true,
        "systemverilog": true,
        "tcl": true,
        "verilog": true,
        "yaml": true
    },

    // Stop Listing No Requested Ports
    "remote.autoForwardPorts": false,
    "remote.restoreForwardedPorts": false,
    "remote.portsAttributes": {
        "all": {
            "onAutoForward": "ignore",
            "elevateIfNeeded": false
        }
    },

    // Integrate ubCode CLI With VS Code Terminal
    "ubcode.cli.terminalIntegration": false,   

}
